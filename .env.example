MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=

# Bootstrap inicial de usuários/workspace
# Em produção, defina estes valores para criar o primeiro super admin.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_WORKSPACE_NAME=

# Assinatura no billing atual via Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_TEST_ACCESS_TOKEN=
MERCADO_PAGO_TEST_SITE_ID=MLB

# Jobs protegidos de manutenção e reconciliação de billing
CRON_SECRET=

# E-mail transacional para recuperação de acesso
# Suporte atual: Resend via HTTP.
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# ERP DaBi Tech - integração da precificadora
ERP_APP_URL=
PRICING_INTEGRATION_TOKEN=
# Contexto opcional enviado para o ERP quando a integração exigir escopo fixo.
PRICING_CONTEXT_TENANT_ID=
PRICING_CONTEXT_COMPANY_ID=
PRICING_CONTEXT_STORE_ID=

# Vercel Blob - obrigatório para client upload de imagens do fluxo ERP
BLOB_READ_WRITE_TOKEN=

# Fallback legado/manual
MELI_ACCESS_TOKEN=
MELI_USER_ID=

# Observabilidade Sentry. Mantenha vazias no desenvolvimento local.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Use hml para a branch release/homologation, classificada como Production na Vercel.
SENTRY_ENVIRONMENT=
# Segredo temporario para validar excecoes de servidor apenas na HML.
SENTRY_TEST_SECRET=
# Configuracao de build para source maps. Nao commitar um token real.
SENTRY_ORG=dabi-tech
SENTRY_PROJECT=dabi-price
SENTRY_AUTH_TOKEN=
