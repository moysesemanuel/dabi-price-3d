{
  "name": "dabi-price-3d",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3005",
    "dev:turbo": "next dev -p 3005",
    "dev:webpack": "next dev --webpack -p 3005",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "start:3005": "next start -p 3005",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:pricing": "node --no-warnings --experimental-specifier-resolution=node --test tests/*.test.mjs",
    "test:auth-postgres-integration": "node --no-warnings --experimental-loader ./tests/support/server-only-loader.mjs --experimental-specifier-resolution=node --test tests/auth-postgres-concurrency.integration.mjs",
    "test:billing-recovery-postgres-integration": "node --no-warnings --experimental-loader ./tests/support/server-only-loader.mjs --experimental-specifier-resolution=node --test tests/billing-recovery-postgres.integration.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:pricing && npm run build:webpack"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/nextjs": "^10.72.0",
    "@vercel/blob": "^2.4.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "postgres": "^3.4.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
